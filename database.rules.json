{
  "rules": {
    "wiesn2026": {
      ".read": false,
      ".write": false,
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false,
          ".validate": "newData.val() === true"
        }
      },
      "users": {
        ".read": "auth != null && root.child('wiesn2026/admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('wiesn2026/admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('wiesn2026/admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name','pinHash']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 80 && newData.child('pinHash').isString() && newData.child('pinHash').val().length === 64"
        }
      },
      "orders": {
        ".read": "auth != null && root.child('wiesn2026/admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('wiesn2026/admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('wiesn2026/admins').child(auth.uid).val() === true)",
          "$item": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0)"
          }
        }
      },
      "favorites": {
        ".read": "auth != null && root.child('wiesn2026/admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('wiesn2026/admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('wiesn2026/admins').child(auth.uid).val() === true)"
        }
      },
      "invoice": {
        ".read": "auth != null && root.child('wiesn2026/admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('wiesn2026/admins').child(auth.uid).val() === true",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
      },
      "logs": {
        ".read": "auth != null && root.child('wiesn2026/admins').child(auth.uid).val() === true",
        ".write": "auth != null",
        "$logId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['ts','uid','targetUid','userName','itemId','itemName','oldQty','newQty','delta','action','source']) && newData.child('uid').val() === auth.uid)",
          ".write": "auth != null && (!data.exists() || root.child('wiesn2026/admins').child(auth.uid).val() === true)"
        }
      }
    }
  }
}